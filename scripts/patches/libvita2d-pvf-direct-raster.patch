+int vita2d_pvf_set_char_size(vita2d_pvf *font, float size)
+{
+	if (!font || size <= 0.0f)
+		return -1;
+
+	vita2d_pvf_font_handle *tmp = font->font_handle_list;
+	while (tmp) {
+		if (scePvfSetCharSize(tmp->font_handle, size, size) < 0)
+			return -1;
+		tmp = tmp->next;
+	}
+
+	/* generic_pvf_draw_text uses vsize for line advances and dimensions. */
+	font->vsize = size;
+	return 0;
+}
+
+void vita2d_pvf_get_glyph_stats(vita2d_pvf *font, unsigned int *glyphs,
+					unsigned int *failures)
+{
+	if (!font)
+		return;
+
+	sceKernelLockLwMutex(&font->mutex, 1, NULL);
+	if (glyphs)
+		*glyphs = font->glyph_count;
+	if (failures)
+		*failures = font->glyph_failures;
+	sceKernelUnlockLwMutex(&font->mutex, 1);
+}
