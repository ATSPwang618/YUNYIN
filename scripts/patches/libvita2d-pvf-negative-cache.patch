diff --git a/libvita2d/source/vita2d_pvf.c b/libvita2d/source/vita2d_pvf.c
--- a/libvita2d/source/vita2d_pvf.c
+++ b/libvita2d/source/vita2d_pvf.c
@@ -28,7 +28,11 @@ typedef struct vita2d_pvf {
 	ScePvfLibId lib_handle;
 	vita2d_pvf_font_handle *font_handle_list;
 	texture_atlas *atlas;
+	/* Characters that are known not to rasterize.  Without this negative
+	 * cache, an unsupported song-title character retries the PVF lookup on
+	 * every frame and keeps the render mutex occupied. */
+	int_htab *failed_glyphs;
 	SceKernelLwMutexWork mutex;
 	float vsize;
 	unsigned int glyph_count;
 	unsigned int glyph_failures;
@@ -60,6 +64,7 @@ static void vita2d_load_pvf_post(vita2d_pvf *font)
 
 	font->atlas = texture_atlas_create(ATLAS_DEFAULT_W, ATLAS_DEFAULT_H,
 		SCE_GXM_TEXTURE_FORMAT_U8_R111);
+	font->failed_glyphs = int_htab_create(256);
 
 	sceKernelCreateLwMutex(&font->mutex, "vita2d_pvf_mutex", 2, 0, NULL);
 }
@@ -247,6 +252,8 @@ void vita2d_free_pvf(vita2d_pvf *font)
 		}
 		scePvfDoneLib(font->lib_handle);
 		texture_atlas_free(font->atlas);
+		if (font->failed_glyphs)
+			int_htab_free(font->failed_glyphs);
 		free(font);
 	}
 }
@@ -275,12 +282,23 @@ static int atlas_add_glyph(vita2d_pvf *font, ScePvfFontId font_handle, unsigned int character)
 	void *texture_data;
 	vita2d_texture *tex = font->atlas->texture;
 
+	if (font->failed_glyphs && int_htab_find(font->failed_glyphs, character) != NULL)
+		return 0;
+
+#define RECORD_GLYPH_FAILURE() do { \
+		font->glyph_failures++; \
+		if (font->failed_glyphs) { \
+			void *marker = malloc(1); \
+			if (marker) int_htab_insert(font->failed_glyphs, character, marker); \
+		} \
+	} while (0)
+
 	if (scePvfGetCharInfo(font_handle, character, &char_info) < 0) {
-		font->glyph_failures++;
+		RECORD_GLYPH_FAILURE();
 		return 0;
 	}
 
 	if (scePvfGetCharImageRect(font_handle, character, &char_image_rect) < 0) {
-		font->glyph_failures++;
+		RECORD_GLYPH_FAILURE();
 		return 0;
 	}
@@ -300,6 +318,6 @@ static int atlas_add_glyph(vita2d_pvf *font, ScePvfFontId font_handle, unsigned int character)
 
 	if (!texture_atlas_insert(font->atlas, character, &size, &data,
 				  &position)) {
-		font->glyph_failures++;
+		RECORD_GLYPH_FAILURE();
 			return 0;
 	}
@@ -317,9 +335,10 @@ static int atlas_add_glyph(vita2d_pvf *font, ScePvfFontId font_handle, unsigned int character)
 	glyph_image.buffer = (ScePvfU8 *)texture_data;
 
 	if (scePvfGetCharGlyphImage(font_handle, character, &glyph_image) < 0) {
-		font->glyph_failures++;
+		RECORD_GLYPH_FAILURE();
 		return 0;
 	}
 	font->glyph_count++;
+	#undef RECORD_GLYPH_FAILURE
 	return 1;
 }
